{
  "name": "salesstock-pro",
  "version": "1.0.0",
  "description": "Sistema de Gestión de Ventas e Inventario con Firebase Auth y Firestore",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.15.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "verbose": true,
    "collectCoverageFrom": [
      "js/**/*.js",
      "app.js"
    ]
  },
  "build": {
    "appId": "com.salesstock.pro",
    "productName": "SalesStock Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release/**/*",
      "!coverage/**/*",
      "!**/.git/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
