# ============================================================================
#  PLANTILLA DE CONFIGURACIÓN DE FIREBASE
#  Copia este archivo como firebase-config.js y reemplaza con tus credenciales.
#  Obtén las credenciales de: https://console.firebase.google.com
#  Configuración -> Tus apps -> Web
# ============================================================================

# Firebase project ID
FIREBASE_PROJECT_ID=salesstock-pro-XXXX

# Firebase API key (pública en cliente, pero no debes commitearla)
FIREBASE_API_KEY=TU_API_KEY_AQUI

# Auth domain
FIREBASE_AUTH_DOMAIN=salesstock-pro-XXXX.firebaseapp.com

# Firestore database URL
FIREBASE_DATABASE_URL=https://salesstock-pro-XXXX.firebaseio.com

# Storage bucket
FIREBASE_STORAGE_BUCKET=salesstock-pro-XXXX.firebasestorage.app

# Messaging sender ID
FIREBASE_MESSAGING_SENDER_ID=XXXXXXXXXXXX

# App ID (web)
FIREBASE_APP_ID=1:XXXXXXXXXX:web:XXXXXXXX

# Measurement ID (opcional)
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Admin password hash (SHA-256 of the admin password)
# Generate with: echo -n "tu_password" | sha256sum
ADMIN_PASSWORD_HASH=

# Firebase App Check reCAPTCHA v3 site key (para protección de bots)
# Obténlo en: Firebase Console > App Check > Web > reCAPTCHA
RECAPTCHA_SITE_KEY=
